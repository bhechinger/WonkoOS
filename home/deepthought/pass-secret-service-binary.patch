+            collection = await get_collection(bus, "/org/freedesktop/secrets/aliases/default")
+            _, session = await service.call_open_session("plain", Variant("s", ""))
+            path, _ = await collection.call_create_item({}, [session, b"", value, "application/octet-stream"], False)
+        async with ServiceEnv(clean=False):
+            service = await get_service(bus)
+            _, session = await service.call_open_session("plain", Variant("s", ""))
+            item = await get_item(bus, path)
+            assert await item.call_get_secret(session) == [session, b"", value, "application/octet-stream"]
+
