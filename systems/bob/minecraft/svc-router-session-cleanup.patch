@@ -0,0 +1,32 @@
+package main
+
+import (
+	"net"
+	"testing"
+
+	"github.com/google/uuid"
+)
+
+func TestCloseSessionsForPlayer(t *testing.T) {
+	playerID := uuid.New()
+	conn, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.ParseIP("127.0.0.1")})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	sessions = map[string]*Session{
+		"client": {
+			BackendConn: conn,
+			PlayerID:    playerID,
+		},
+	}
+
+	closeSessionsForPlayer(playerID)
+
+	if len(sessions) != 0 {
+		t.Fatalf("session was not removed: %#v", sessions)
+	}
+	if err := conn.Close(); err == nil {
+		t.Fatal("session connection was not closed")
+	}
+}
