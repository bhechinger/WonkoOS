+++ b/test/test_binary_storage.py
@@ -0,0 +1,112 @@
+import base64
+import json
+import os
+import subprocess
+import threading
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+
+from pass_secret_service.common.pass_store import PassStore
+from pypass.passwordstore import GPG_BIN
+
+
+@pytest.fixture
+def store_collection():
+    store = PassStore(path=os.environ["PASSWORD_STORE_DIR"])
+    collection = store.create_collection({})
+    yield store, collection
+    store.delete_collection(collection)
+
+
+@pytest.mark.parametrize("value", ["", "ordinary password\n", "a\x00b", "café", '{"version":1,"value":"/w==","content_type":"binary"}'])
+def test_legacy_text_stays_literal(store_collection, value):
+    store, collection = store_collection
+    store._store.insert_password(os.path.join(store.PREFIX, collection, "legacy"), value)
+    store.save_item_properties(collection, "legacy", {})
+    assert store.get_item_password(collection, "legacy") == (value.encode("utf8"), "text/plain")
+    assert store._store.get_decrypted_password(os.path.join(store.PREFIX, collection, "legacy")) == value
+
+
+def test_encoded_value_and_content_type_are_encrypted(store_collection):
+    store, collection = store_collection
+    value, content_type = b"\x00\xff\xfe\n", "application/x-secret-test"
+    name = store.create_item(collection, (value, content_type), {})
+    path = os.path.join(store.base_path, collection, name) + ".gpg"
+    encoded = subprocess.run([GPG_BIN, "--quiet", "--batch", "--decrypt", path], stdout=subprocess.PIPE, check=True).stdout
+    assert encoded.startswith(store.SECRET_FORMAT)
+    secret = json.loads(encoded[len(store.SECRET_FORMAT) :])
+    assert base64.b64decode(secret["value"], validate=True) == value
+    assert secret["content_type"] == content_type
+    with open(os.path.join(store.base_path, collection, name) + ".properties") as stream:
+        assert content_type not in stream.read()
+    assert store.get_item_password(collection, name) == (value, content_type)
+
+
+def test_new_text_stays_pass_readable(store_collection):
+    store, collection = store_collection
+    value = '{"version":1,"value":"/w==","content_type":"binary"}'
+    name = store.create_item(collection, (value.encode(), "text/plain"), {})
+    assert store._store.get_decrypted_password(os.path.join(store.PREFIX, collection, name)) == value
+    assert store.get_item_password(collection, name) == (value.encode(), "text/plain")
+
+
+@pytest.mark.parametrize(
+    "encoded",
+    [
+        b'\xffpass-secret-service:2\n{"value":"/w==","content_type":"binary"}',
+        b'\xffpass-secret-service:1\n{"value":"!bad-base64!","content_type":"binary"}',
+        b'\xffpass-secret-service:1\n{"value":"/w==","content_type":42}',
+        b"\xffpass-secret-service:1\n[]",
+    ],
+)
+def test_invalid_envelope_is_rejected(store_collection, encoded):
+    store, collection = store_collection
+    name = store.create_item(collection, (b"\xff", "binary"), {})
+    path = os.path.join(store.base_path, collection, name) + ".gpg"
+    subprocess.run([GPG_BIN, "--batch", "--yes", "--encrypt", "--recipient", store._store.gpg_id, "--output", path], input=encoded, check=True)
+    with pytest.raises(ValueError):
+        store.get_item_password(collection, name)
+
+
+def test_secret_does_not_depend_on_item_properties(store_collection):
+    store, collection = store_collection
+    name = store.create_item(collection, (b"\xff", "binary"), {})
+    with open(os.path.join(store.base_path, collection, name) + ".properties", "w") as stream:
+        stream.write("{")
+    assert store.get_item_password(collection, name) == (b"\xff", "binary")
+
+
+def test_failed_encryption_preserves_previous_secret(store_collection, monkeypatch):
+    store, collection = store_collection
+    previous = b"old password", "text/plain"
+    name = store.create_item(collection, previous, {})
+    directory = os.path.join(store.base_path, collection)
+    files = set(os.listdir(directory))
+
+    def fail(*args, **kwargs):
+        raise subprocess.CalledProcessError(1, args[0])
+
+    with monkeypatch.context() as patch:
+        patch.setattr(subprocess, "run", fail)
+        with pytest.raises(subprocess.CalledProcessError):
+            store.set_item_password(collection, name, (b"\xff", "binary"))
+    assert store.get_item_password(collection, name) == previous
+    assert set(os.listdir(directory)) == files
+
+
+def test_concurrent_updates_keep_format_and_value_together(store_collection, monkeypatch):
+    store, collection = store_collection
+    name = store.create_item(collection, (b"initial", "text/plain"), {})
+    values = [(b"\xff\x00", "application/octet-stream"), (b"new text", "text/plain")]
+    barrier = threading.Barrier(2)
+    replace = os.replace
+
+    def synchronized_replace(source, destination):
+        barrier.wait(timeout=10)
+        replace(source, destination)
+
+    monkeypatch.setattr(os, "replace", synchronized_replace)
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        list(executor.map(lambda secret: store.set_item_password(collection, name, secret), values))
+    assert store.get_item_password(collection, name) in values
