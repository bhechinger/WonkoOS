query recent_context($project: String)
    @description("Recent durable agent context")
{
    match {
        $c: Learning
        $c.slug starts_with $project
    }
    return { $c.slug, $c.title, $c.body, $c.learningKind, $c.createdAt, $c.createdBy }
    order { $c.createdAt desc, $c.slug desc }
    limit 50
}

query context_lookup($project: String, $slug: String)
    @description("Fetch one durable agent context record")
{
    match {
        $c: Learning { slug: $slug }
        $c.slug starts_with $project
    }
    return { $c.slug, $c.title, $c.body, $c.learningKind, $c.createdAt, $c.createdBy }
}

query remember_context($slug: String, $title: String, $body: String, $actor: String, $at: Date)
    @description("Append a durable agent context record")
{
    insert Learning { slug: $slug, title: $title, body: $body, learningKind: "hindsight", createdAt: $at, createdBy: $actor }
}
