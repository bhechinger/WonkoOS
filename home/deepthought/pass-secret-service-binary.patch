+    async def test_binary_secret_lifecycle(self, bus, pss_service, value, content_type):
+        service = await get_service(bus)
+        collection = await get_collection(bus, "/org/freedesktop/secrets/aliases/default")
+        _, session = await service.call_open_session("plain", Variant("s", ""))
+        properties = {"org.freedesktop.Secret.Item.Attributes": Variant("a{ss}", {"binary-test": "yes"})}
+        path, _ = await collection.call_create_item(properties, [session, b"", value, content_type], False)
+        item = await get_item(bus, path)
+        await item.set_label("renamed")
+        await item.set_attributes({"binary-test": "yes"})
+        expected = [session, b"", value, content_type]
+        assert await item.call_get_secret(session) == expected
+        assert (await service.call_get_secrets([path], session))[path] == expected
+        await item.call_set_secret([session, b"", b"updated\x00\xff", "application/x-test"])
+        assert await item.call_get_secret(session) == [session, b"", b"updated\x00\xff", "application/x-test"]
+        replacement, _ = await collection.call_create_item(properties, expected, True)
+        assert replacement == path
+        assert await item.call_get_secret(session) == expected
+        await item.call_set_secret([session, b"", b"text again\n", "text/plain"])
+        assert await item.call_get_secret(session) == [session, b"", b"text again\n", "text/plain"]
+
+    @pytest.mark.asyncio
